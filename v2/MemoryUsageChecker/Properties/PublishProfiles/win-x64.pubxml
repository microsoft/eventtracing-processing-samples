<?xml version="1.0" encoding="utf-8"?>
<!--
Publish profile for a self-contained, single-file Windows x64 build.

Usage:
    dotnet publish -p:PublishProfile=win-x64

Output (relative to project):
    bin\Release\net10.0\win-x64\publish\MemoryUsageChecker.exe

Trimming is intentionally disabled: Microsoft.Windows.EventTracing uses
reflection extensively to parse ETW event payloads, and trimming removes
types it needs at runtime.
-->
<Project>
	<PropertyGroup>
		<Configuration>Release</Configuration>
		<Platform>Any CPU</Platform>
		<PublishProtocol>FileSystem</PublishProtocol>
		<TargetFramework>net10.0</TargetFramework>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>true</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
		<PublishReadyToRun>false</PublishReadyToRun>
		<PublishTrimmed>false</PublishTrimmed>
	</PropertyGroup>
</Project>
